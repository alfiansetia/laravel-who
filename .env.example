APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
# Prod: LOG_LEVEL=warning agar single file tidak bengkak.

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
# Selaras EnvAuth 24 jam (sebelumnya 120 menit bikin session Laravel mati duluan).
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Prod (workload Odoo-proxy + polling): SESSION_DRIVER=file|redis, CACHE_STORE=file|redis.
# database hanya untuk dev agar tanpa kontensi tabel cache/sessions.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
# Produksi: bucket + custom domain produksi. Dev local: pakai bucket TERPISAH
# (mis. mapwho-dev) dengan custom domain/dev URL-nya sendiri. Jangan pakai
# bucket produksi untuk development agar tidak mengotori/menghapus data asli.
# Contoh dev:  AWS_BUCKET=mapwho-dev
# Contoh prod: AWS_BUCKET=mapwho
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
ODOO_DOMAIN=
ODOO_DOMAIN_WEB=
ODOO_EMAIL=
ODOO_PASSWORD=
ODOO_DB=

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
# VAPID publik untuk Web Push (wajib agar token FCM terbit).
# Ambil di Firebase Console → Project settings → Cloud Messaging → Web Push certificates → Generate key pair.
FIREBASE_VAPID_KEY=

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELE_GROUP_ID=

ADMIN_PASS=
SPREADSHEET_URL=

TIKI_API_URL=
TIKI_API_KEY=